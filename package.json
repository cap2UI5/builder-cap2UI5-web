    "smoke": "node smoke.mjs",
    "smoke:live": "node live-smoke.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
